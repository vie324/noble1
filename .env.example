# Supabase プロジェクトの設定（Project Settings → API からコピー）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー専用の秘密鍵。NEXT_PUBLIC を付けず、コミットもしないこと。
# 用途: ① scripts/create-users.mjs（スタッフアカウント作成）
#       ② お客様向け公開フォーム /f/...（カウンセリング・同意書）の読み書き
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Googleカレンダー購読（iCalフィード /api/ics）用の任意のシークレット文字列。
# 設定すると購読URL https://<本番>/api/ics?key=<この値> が有効になります。
ICAL_FEED_SECRET=your-random-secret

# サロンワン 分析API のアクセスキー（サーバー専用。NEXT_PUBLIC を付けず、コミットもしないこと）。
# 経営サマリーの実績（売上・新規数）をサロンワンから取り込むのに使います。
# キーは発行時に一度しか表示されません。紛失したらサロンワン運営に失効と再発行を依頼してください。
SALONONE_API_KEY=your-salonone-api-key

# Vercel Cron（毎朝のサロンワン取り込み /api/salonone/sync）を認証する任意のシークレット文字列。
# Vercel の環境変数に設定すると、Cron の呼び出しに自動で付与されます。未設定だと自動取り込みは動きません。
CRON_SECRET=your-random-secret

# （ローカル検証専用・本番では設定しない）LINE Messaging API の接続先をモックに差し替えるときだけ指定します。
# 未設定なら https://api.line.me を使います。
# LINE_API_BASE_URL=http://localhost:54321/line-api
