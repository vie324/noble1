# Supabase プロジェクトの設定（Project Settings → API からコピー）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー専用の秘密鍵。NEXT_PUBLIC を付けず、コミットもしないこと。
# 用途: ① scripts/create-users.mjs（スタッフアカウント作成）
#       ② お客様向け公開フォーム /f/...（カウンセリング・同意書）の読み書き
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Googleカレンダー購読（iCalフィード /api/ics）用の任意のシークレット文字列。
# 設定すると購読URL https://<本番>/api/ics?key=<この値> が有効になります。
ICAL_FEED_SECRET=your-random-secret
